{
  "name": "@allenyolk/pi-minimal-display",
  "version": "0.2.1",
  "publishConfig": {
    "access": "public"
  },
  "description": "Compact, expandable Pi tool cards with reversible presentation patches.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AllenYolk/pi-extensions.git",
    "directory": "packages/pi-minimal-display"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": "./src/index.ts",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "keywords": [
    "pi-package",
    "pi",
    "tool-rendering"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "npm run typecheck && npm test",
    "benchmark": "npm run build && node test/benchmark.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0"
  }
}
